rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isManagerOrAdmin() {
      return isSignedIn() && (role() == 'manager' || role() == 'admin');
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isManagerOrAdmin());
      allow create, delete: if false; // accounts are provisioned server-side
      // Everyone can self-update phone/notificationPreferences/photoUrl.
      // Managers and admins can also change their own display name - unlike
      // associates, it isn't anchored to a Cortex identity match, so there's
      // nothing for a name edit to break.
      allow update: if isSignedIn() && request.auth.uid == userId
                    && (
                      request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['phone', 'notificationPreferences', 'photoUrl'])
                      || (
                        role() in ['manager', 'admin']
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['phone', 'notificationPreferences', 'photoUrl', 'fullName'])
                      )
                    );

      match /notifications/{notifId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow write: if isManagerOrAdmin();
    }

    match /redemptionRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isManagerOrAdmin());
      allow create, update, delete: if false; // must go through requestRedemption / resolveRedemption
    }

    match /pendingReview/{reviewId} {
      allow read: if isManagerOrAdmin();
      allow write: if false; // Cloud Functions only
    }

    match /roster/{rosterId} {
      allow read: if isManagerOrAdmin() || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);
      allow write: if false; // Cloud Functions only

      match /ledger/{week} {
        allow read: if isManagerOrAdmin()
                    || (isSignedIn() &&
                        get(/databases/$(database)/documents/roster/$(rosterId)).data.linkedUserId == request.auth.uid);
        allow write: if false; // Cloud Functions only
      }
    }

    match /cortexImports/{importId} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    match /syncStatus/{statusId} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    match /bonusTasks/{taskId} {
      allow read: if isSignedIn(); // everyone can browse the task library
      allow write: if false; // Cloud Functions only

      match /enrollments/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isManagerOrAdmin());
        allow write: if false; // Cloud Functions only
      }
    }

    match /announcements/{announcementId} {
      // Headcount needed, point value, etc. are visible to everyone -
      // enrollment counts/lists are NOT here, see the enrollments subcollection.
      allow read: if isSignedIn();
      allow write: if false; // Cloud Functions only

      match /enrollments/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isManagerOrAdmin());
        allow write: if false; // Cloud Functions only
      }
    }

    match /pointAdjustments/{adjustmentId} {
      allow read: if isManagerOrAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // Cloud Functions only
    }

    match /activityLog/{logId} {
      // Direct reads are admin-only. Managers must go through the
      // queryActivityLog function, since "driver activity only, never
      // admin activity, only if granted" can't be safely expressed here.
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
